# Supabase — copy to .env.local and fill from your project (Settings > API).
# .env.local is git-ignored; never commit real values.

# Safe to expose to the browser (RLS-protected):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Client access gate (PRD D1). Set to "true" in production to require a session.
# CLIENT_GATE_ENABLED=true
# CLIENT_GATE_DEV_BYPASS=true   # local only; inert in production (NODE_ENV check)

# Secret that signs the client-portal session cookie (access-code sign-in).
# REQUIRED wherever the gate is on. Use a long random string, e.g.
#   openssl rand -base64 48
# Rotating it invalidates all active client sessions (they re-enter their code).
CLIENT_SESSION_SECRET=

# Durable rate limiter (POST /api/enquiries). Without these the limiter falls
# back to in-memory (per-instance) — fine for local dev, NOT for production.
# Create an Upstash Redis DB (console.upstash.com) and paste its REST creds:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# CLI only (supabase link / db push) — not read by the app:
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
